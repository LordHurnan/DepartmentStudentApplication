<%= form_with model: classlist do |form| %>

  <% if classlist.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(classlist.errors.count, "error") %>
        prohibited this class list from being saved:
      </h5>

      <ul class="mb-0">
        <% classlist.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Student -->
  <div class="mb-3">
    <%= form.label :student_id, "Student", class: "form-label" %>

    <%= form.collection_select :student_id,
        Student.order(:name),
        :id,
        :name,
        { prompt: "Select Student" },
        { class: "form-select" } %>
  </div>

  <!-- Section -->
  <div class="mb-4">
    <%= form.label :section_id, "Section", class: "form-label" %>

    <%= form.collection_select :section_id,
        Section.order(:name),
        :id,
        :name,
        { prompt: "Select Section" },
        { class: "form-select" } %>
  </div>

  <!-- Buttons -->
  <div class="d-flex gap-2">

    <%= form.submit classlist.new_record? ? "Create Class List" : "Update Class List",
        class: "btn btn-primary" %>

    <%= link_to "Cancel",
        classlist.new_record? ? classlists_path : classlist,
        class: "btn btn-outline-secondary" %>

  </div>

<% end %>