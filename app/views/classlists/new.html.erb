<% content_for :title, "New Class List" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">New Class List</h1>
    <p class="text-muted mb-0">
      Enroll a student in a section
    </p>
  </div>

  <%= link_to "Back to Class Lists",
      classlists_path,
      class: "btn btn-outline-secondary" %>
</div>

<div class="card shadow-sm">
  <div class="card-header">
    <h3 class="mb-0">Class List Information</h3>
  </div>

  <div class="card-body">
    <%= render "form", classlist: @classlist %>
  </div>
</div>