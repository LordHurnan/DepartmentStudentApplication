<p class="text-success"><%= notice %></p>

<% content_for :title, "Class Lists" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">Class Lists</h1>
  </div>
</div>

<div id="classlists" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">

    <thead class="table-dark">
      <tr>
        <th>Student</th>
        <th>Sections</th>
        <th>Subjects</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @classlists.group_by(&:student).each do |student, enrollments| %>

        <tr>

          <!-- Student -->
          <td>
            <%= student.name %>
          </td>

          <!-- Sections -->
          <td>
            <% enrollments.each_with_index do |classlist, index| %>

              <% if index > 0 %>
                <hr class="my-2">
              <% end %>

              <%= classlist.section.name %>

            <% end %>
          </td>

          <!-- Subjects -->
          <td>
            <% enrollments.each_with_index do |classlist, index| %>

              <% if index > 0 %>
                <hr class="my-2">
              <% end %>

              <%= classlist.section.subject.name %>

            <% end %>
          </td>

          <!-- Actions -->
          <td class="text-nowrap">
            <% enrollments.each_with_index do |classlist, index| %>

              <% if index > 0 %>
                <hr class="my-2">
              <% end %>

              <%= button_to "Show",
                  classlist,
                  method: :get,
                  class: "btn btn-sm btn-primary",
                  form_class: "d-inline-block" %>

              <%= button_to "Edit",
                  edit_classlist_path(classlist),
                  method: :get,
                  class: "btn btn-sm btn-secondary",
                  form_class: "d-inline-block" %>

              <%= button_to "Delete",
                  classlist,
                  method: :delete,
                  class: "btn btn-sm btn-danger",
                  form_class: "d-inline-block" %>

            <% end %>
          </td>

        </tr>

      <% end %>
    </tbody>

  </table>
</div>

<%= link_to "New class list",
    new_classlist_path,
    class: "btn btn-success" %>