<p class="text-success"><%= notice %></p>

<% content_for :title, "Sections" %>

<h1>Sections</h1>

<%= search_form_for @q, url: sections_path, class: "card card-body mb-4" do |f| %>
  <div class="row g-3 align-items-end">
    <div class="col-md-3">
      <%= f.label :name_or_room_or_timeslot_cont, "Search", class: "form-label" %>
      <%= f.search_field :name_or_room_or_timeslot_cont, class: "form-control",
            placeholder: "Name, room or timeslot..." %>
    </div>

    <div class="col-md-4">
      <%= f.label :subject_id_eq, "Subject", class: "form-label" %>
      <%= f.collection_select :subject_id_eq, Subject.order(:name), :id, :name,
            { include_blank: "All subjects" }, { class: "form-select" } %>
    </div>

    <div class="col-md-2">
      <%= f.label :room_eq, "Room", class: "form-label" %>
      <%= f.select :room_eq,
            Section.where.not(room: [nil, ""]).distinct.order(:room).pluck(:room),
            { include_blank: "All" }, { class: "form-select" } %>
    </div>

    <div class="col-md-3 d-flex gap-2">
      <%= f.submit "Search", class: "btn btn-primary" %>
      <%= link_to "Reset", sections_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
<% end %>

<div id="sections" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">

    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Room</th>
        <th>Timeslot</th>
        <th>Subject</th>
        <th>Students</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @sections.each do |section| %>
        <tr id="<%= dom_id section %>">
          <td><%= section.name %></td>
          <td><%= section.room %></td>
          <td><%= section.timeslot %></td>
          <td><%= section.subject.name %></td>
          <td><%= section.student_count %></td>

          <td class="text-nowrap">
            <%= button_to "Show",
                section,
                method: :get,
                class: "btn btn-sm btn-primary",
                form_class: "d-inline-block" %>

            <%= button_to "Edit",
                edit_section_path(section),
                method: :get,
                class: "btn btn-sm btn-secondary",
                form_class: "d-inline-block" %>

            <%= button_to "Delete",
                section,
                method: :delete,
                class: "btn btn-sm btn-danger",
                form_class: "d-inline-block" %>
          </td>
        </tr>
      <% end %>
    </tbody>

  </table>
</div>

<div class="d-flex justify-content-center mt-3">
  <%== @pagy.series_nav(:bootstrap) %>
</div>

<%= link_to "New section",
    new_section_path,
    class: "btn btn-success" %>