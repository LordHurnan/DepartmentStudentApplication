<p class="text-success"><%= notice %></p>

<% content_for :title, "Teachers" %>

<h1>Teachers</h1>

<%= search_form_for @q, url: teachers_path, class: "card card-body mb-4" do |f| %>
  <div class="row g-3 align-items-end">
    <div class="col-md-5">
      <%= f.label :name_cont, "Search", class: "form-label" %>
      <%= f.search_field :name_cont, class: "form-control", placeholder: "Teacher name..." %>
    </div>
    <div class="col-md-4">
      <%= f.label :department_id_eq, "Department", class: "form-label" %>
      <%= f.collection_select :department_id_eq, Department.order(:name), :id, :name,
            { include_blank: "All departments" }, { class: "form-select" } %>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <%= f.submit "Search", class: "btn btn-primary" %>
      <%= link_to "Reset", teachers_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
<% end %>

<div id="teachers" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">

    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Specialization</th>
        <th>Department</th>
        <th>Subjects</th>
        <th>Monthly Salary</th>
        <th>Per Unit Rate</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @teachers.each do |teacher| %>
        <tr id="<%= dom_id teacher %>">

          <td><%= teacher.name %></td>

          <td><%= teacher.email %></td>

          <td><%= teacher.specialization %></td>

          <td><%= teacher.department.name %></td>

          <td><%= teacher.subjects.count %></td>

          <td>
            <%= number_to_currency teacher.monthly_salary, unit: "₱" %>
          </td>

          <td>
            <%= number_to_currency teacher.per_unit_rate, unit: "₱" %>
          </td>

          <td class="text-nowrap">

            <%= button_to "Show",
                teacher,
                method: :get,
                class: "btn btn-sm btn-primary",
                form_class: "d-inline-block" %>

            <%= button_to "Edit",
                edit_teacher_path(teacher),
                method: :get,
                class: "btn btn-sm btn-secondary",
                form_class: "d-inline-block" %>

            <%= button_to "Delete",
                teacher,
                method: :delete,
                class: "btn btn-sm btn-danger",
                form_class: "d-inline-block" %>

          </td>

        </tr>
      <% end %>
    </tbody>

  </table>
</div>

<div class="d-flex justify-content-center mt-3">
  <%== @pagy.series_nav(:bootstrap) %>
</div>

<%= link_to "New teacher",
    new_teacher_path,
    class: "btn btn-success" %>