<% content_for :title, @student.name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1"><%= @student.name %></h1>
    <p class="text-muted mb-0">
      <%= @student.program %> Year <%= @student.year_level %>
    </p>
  </div>

  <%= link_to "Back to Students", students_path, class: "btn btn-outline-secondary" %>
</div>

<!-- Student Details -->
<div class="card shadow-sm mb-4">
  <div class="card-header">
    <h3 class="mb-0">Student Details</h3>
  </div>

  <div class="card-body">
    <div class="row">

      <!-- Student Information -->
      <div class="col-md-5">
        <h6 class="text-muted">Name</h6>
        <p><%= @student.name %></p>

        <h6 class="text-muted">Year Level</h6>
        <p><%= @student.year_level %></p>

        <h6 class="text-muted">Program</h6>
        <p><%= @student.program %></p>

        <h6 class="text-muted">Department</h6>
        <p><%= @student.department.name %></p>
      </div>

      <!-- Enrollment Summary -->
      <div class="col-md-5">
        <h6 class="text-muted mb-3">Enrollment Summary</h6>

        <div class="row g-3">
          <div class="col-md-4">
            <div class="card bg-light h-100 text-center">
              <div class="card-body">
                <h6 class="card-title text-muted">Subjects</h6>
                <h3 class="mb-0"><%= @student.subject_count %></h3>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="card bg-light h-100 text-center">
              <div class="card-body">
                <h6 class="card-title text-muted">Units</h6>
                <h3 class="mb-0"><%= @student.number_of_units %></h3>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="card bg-light h-100 text-center">
              <div class="card-body">
                <h6 class="card-title text-muted">Tuition Fee</h6>
                <h4 class="mb-0">
                  <%= number_to_currency @student.tuition_fee, unit: "P" %>
                </h4>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Student QR Code -->
      <div class="col-md-2 text-center">
        <h6 class="text-muted mb-2">Student QR Code</h6>

        <div class="border rounded p-2 d-inline-block bg-white">
          <%= raw @qr_code.as_svg(module_size: 3, standalone: true) %>
        </div>

        <p class="small text-muted mt-2 mb-0">
          Scan to view profile
        </p>
      </div>

    </div>
  </div>
</div>

<!-- Enrolled Subjects -->
<div class="card shadow-sm mb-4">
  <div class="card-header">
    <h3 class="mb-0">Enrolled Subjects</h3>
  </div>

  <div class="card-body">
    <% if @student.classlists.any? %>
      <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Subject</th>
              <th>Section</th>
              <th>Room</th>
              <th>Timeslot</th>
              <th>Teacher</th>
              <th>Units</th>
            </tr>
          </thead>

          <tbody>
            <% @student.classlists.each do |classlist| %>
              <tr>
                <td><%= classlist.section.subject.name %></td>
                <td><%= classlist.section.name %></td>
                <td><%= classlist.section.room %></td>
                <td><%= classlist.section.timeslot %></td>
                <td><%= classlist.section.subject.teacher.name %></td>
                <td><%= classlist.section.subject.number_of_units %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0">No subjects enrolled.</p>
    <% end %>
  </div>
</div>

<!-- Enroll in a Section -->
<div class="card shadow-sm mb-4">
  <div class="card-header">
    <h3 class="mb-0">Enroll in a Section</h3>
  </div>

  <div class="card-body">
    <%= form_with model: @classlist, local: true do |form| %>
      <%= form.hidden_field :student_id, value: @student.id %>

      <div class="mb-3">
        <%= form.label :section_id, "Section", class: "form-label" %>

        <%= form.collection_select :section_id,
            @available_sections,
            :id,
            :name,
            { prompt: "Select a section" },
            { class: "form-select" } %>
      </div>

      <%= hidden_field_tag :from_student, @student.id %>
      <%= form.submit "Enroll", class: "btn btn-success" %>
    <% end %>
  </div>
</div>

<!-- Change History - PaperTrail -->
<div class="card shadow-sm mb-4">
  <div class="card-header py-2">
    <span class="fw-semibold">Change History</span>
    <small class="text-muted">(paper_trail)</small>
  </div>

  <div class="card-body p-0">
    <% versions = @student.versions.order(created_at: :desc) %>

    <% if versions.any? %>
      <% versions.each do |version| %>
        <div class="px-3 py-2 border-bottom">
          <div class="mb-1">
            <strong><%= version.event.humanize %></strong>
            <span class="text-muted">
              · <%= version.created_at.strftime("%b %d, %Y %H:%M") %>
            </span>
          </div>

          <% (version.changeset || {}).each do |field, values| %>
            <div class="small mb-1">
              <span class="text-danger">
                <%= field %>: <%= values[0].inspect %>
              </span>
              →
              <span class="text-success">
                <%= values[1].inspect %>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted p-3 mb-0">
        No change history available.
      </p>
    <% end %>
  </div>
</div>