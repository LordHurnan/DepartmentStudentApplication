<p class="text-success"><%= notice %></p>

<% content_for :title, "Students" %>

<h1>Students</h1>

<%= search_form_for @q, class: "card card-body mb-4" do |f| %>
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <%= f.label :name_or_program_cont, "Search", class: "form-label" %>
      <%= f.search_field :name_or_program_cont,
      class: "form-control",
      placeholder: "Student name or program..." %>
    </div>

    <div class="col-md-3">
      <%= f.label :department_id_eq, "Department", class: "form-label" %>
      <%= f.collection_select :department_id_eq, Department.order(:name), :id, :name,
            { include_blank: "All departments" },
            { class: "form-select" } %>
    </div>

    <div class="col-md-3">
      <%= f.label :sections_name_eq, "Section", class: "form-label" %>
      <%= f.collection_select :sections_name_eq, Section.order(:name).distinct, :name, :name,
            { include_blank: "All sections" },
            { class: "form-select" } %>
    </div>

    <div class="col-md-2 d-flex gap-2">
      <%= f.submit "Search", class: "btn btn-primary" %>
      <%= link_to "Reset", students_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
<% end %>

<div id="students" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">

    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Year Level</th>
        <th>Program</th>
        <th>Department</th>
        <th>Subjects</th>
        <th>Units</th>
        <th>Tuition Fee</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @students.each do |student| %>
        <tr id="<%= dom_id student %>">
          <td><%= student.name %></td>
          <td><%= student.year_level %></td>
          <td><%= student.program %></td>
          <td><%= student.department.name %></td>
          <td><%= student.subject_count %></td>
          <td><%= student.number_of_units %></td>
          <td><%= number_to_currency student.tuition_fee, unit: "P" %></td>

          <td class="text-nowrap">
            <%= button_to "Show",
                student,
                method: :get,
                class: "btn btn-sm btn-primary",
                form_class: "d-inline-block" %>

            <%= button_to "Edit",
                edit_student_path(student),
                method: :get,
                class: "btn btn-sm btn-secondary",
                form_class: "d-inline-block" %>

            <%= button_to "Delete",
                student,
                method: :delete,
                class: "btn btn-sm btn-danger",
                form_class: "d-inline-block" %>
          </td>
        </tr>
      <% end %>
    </tbody>

  </table>
</div>

<div class="d-flex justify-content-center mt-3">
  <%== @pagy.series_nav(:bootstrap) %>
</div>

<%= link_to "New student",
    new_student_path,
    class: "btn btn-success" %>