<% content_for :title, "New Laboratory" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">New Laboratory</h1>
    <p class="text-muted mb-0">
      Add a new laboratory
    </p>
  </div>

  <%= link_to "Back to Laboratories",
      laboratories_path,
      class: "btn btn-outline-secondary" %>
</div>

<div class="card shadow-sm">
  <div class="card-header">
    <h3 class="mb-0">Laboratory Information</h3>
  </div>

  <div class="card-body">
    <%= render "form", laboratory: @laboratory %>
  </div>
</div>