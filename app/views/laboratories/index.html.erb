<p class="text-success"><%= notice %></p>

<% content_for :title, "Laboratories" %>

<%= search_form_for @q, url: laboratories_path, class: "card card-body mb-4" do |f| %>
  <div class="row g-3 align-items-end">
    <div class="col-md-9">
      <%= f.label :name_cont, "Search", class: "form-label" %>
      <%= f.search_field :name_cont, class: "form-control", placeholder: "Laboratory name..." %>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <%= f.submit "Search", class: "btn btn-primary" %>
      <%= link_to "Reset", laboratories_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">Laboratories</h1>
  </div>
</div>

<div id="laboratories" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">

    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Location</th>
        <th>Department</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @laboratories.each do |laboratory| %>
        <tr id="<%= dom_id laboratory %>">

          <td>
            <%= laboratory.name %>
          </td>

          <td>
            <%= laboratory.location %>
          </td>

          <td>
            <%= laboratory.department&.name || "N/A" %>
          </td>

          <td class="text-nowrap">

            <%= button_to "Show",
                laboratory,
                method: :get,
                class: "btn btn-sm btn-primary",
                form_class: "d-inline-block" %>

            <%= button_to "Edit",
                edit_laboratory_path(laboratory),
                method: :get,
                class: "btn btn-sm btn-secondary",
                form_class: "d-inline-block" %>

            <%= button_to "Delete",
                laboratory,
                method: :delete,
                class: "btn btn-sm btn-danger",
                form_class: "d-inline-block" %>

          </td>

        </tr>
      <% end %>
    </tbody>

  </table>
</div>

<div class="d-flex justify-content-center mt-3">
  <%== @pagy.series_nav(:bootstrap) %>
</div>

<%= link_to "New laboratory",
    new_laboratory_path,
    class: "btn btn-success" %>