<% content_for :title, @laboratory.name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1"><%= @laboratory.name %></h1>
    <p class="text-muted mb-0">
      Laboratory Information
    </p>
  </div>

  <%= link_to "Back to Laboratories",
      laboratories_path,
      class: "btn btn-outline-secondary" %>
</div>

<!-- Laboratory Details -->
<div class="card shadow-sm mb-4">
  <div class="card-header">
    <h3 class="mb-0">Laboratory Details</h3>
  </div>

  <div class="card-body">
    <div class="row">

      <div class="col-md-6">
        <h6 class="text-muted">Name</h6>
        <p><%= @laboratory.name %></p>

        <h6 class="text-muted">Location</h6>
        <p><%= @laboratory.location %></p>

        <h6 class="text-muted">Department</h6>
        <p>
          <%= @laboratory.department&.name || "N/A" %>
        </p>
      </div>

    </div>
  </div>
</div>

<!-- Laboratory Actions -->
<div class="card shadow-sm">
  <div class="card-header">
    <h3 class="mb-0">Laboratory Actions</h3>
  </div>

  <div class="card-body">

    <div class="d-flex gap-2">

      <%= link_to "Edit Laboratory",
          edit_laboratory_path(@laboratory),
          class: "btn btn-primary" %>

      <%= button_to "Delete Laboratory",
          @laboratory,
          method: :delete,
          class: "btn btn-danger" %>

      <%= link_to "Back to Laboratories",
          laboratories_path,
          class: "btn btn-outline-secondary" %>

    </div>

  </div>
</div>