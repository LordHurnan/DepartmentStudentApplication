<%= form_with model: laboratory do |form| %>

  <% if laboratory.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(laboratory.errors.count, "error") %>
        prohibited this laboratory from being saved:
      </h5>

      <ul class="mb-0">
        <% laboratory.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Name -->
  <div class="mb-3">
    <%= form.label :name, "Name", class: "form-label" %>

    <%= form.text_field :name,
        class: "form-control",
        placeholder: "Enter laboratory name" %>
  </div>

  <!-- Location -->
  <div class="mb-3">
    <%= form.label :location, "Location", class: "form-label" %>

    <%= form.text_field :location,
        class: "form-control",
        placeholder: "Enter laboratory location" %>
  </div>

  <!-- Department -->
  <div class="mb-4">
    <%= form.label :department_id, "Department", class: "form-label" %>

    <%= form.collection_select :department_id,
        Department.order(:name),
        :id,
        :name,
        { prompt: "Select Department" },
        { class: "form-select" } %>
  </div>

  <!-- Buttons -->
  <div class="d-flex gap-2">

    <%= form.submit "Update Laboratory",
        class: "btn btn-primary" %>

    <%= link_to "Cancel",
        @laboratory,
        class: "btn btn-outline-secondary" %>

  </div>

<% end %>