<p style="color: green"><%= notice %></p>

<%= render @department %>

<div>
<% if @department.students.any? %>
  <h3>List of Students:</h3>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Program</th>
        <th>Year Level</th>
      </tr>
    </thead>

    <tbody>
      <% @department.students.each do |student| %>
        <tr>
          <td><%= student.name %></td>
          <td><%= student.program %></td>
          <td><%= student.year_level %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
</div>
