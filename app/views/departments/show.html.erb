<p style="color: green"><%= notice %></p>

<%= render @department %>

<br>

<!-- CSS Grid Container for Column Layout -->
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
  
  <!-- Column 1: Students -->
  <div>
    <h3>List of Students:</h3>

    <%= form_with(model: @student) do |f| %>
      <%= hidden_field_tag :from_department, @department.id %>
      <!-- Add your student fields here -->
      <%= f.submit "Add Student" %>
    <% end %>

    <br>

    <% if @department.students.any? %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Program</th>
            <th>Year Level</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @department.students.each do |student| %>
            <tr>
              <td><%= student.name %></td>
              <td><%= student.program %></td>
              <td><%= student.year_level %></td>
              <td>
                <%= button_to "Delete", student_path(student, from_department: @department.id), method: :delete, data: { confirm: "Are you sure?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>No students in this department.</p>
    <% end %>
  </div>

  <!-- Column 2: Teachers -->
  <div>
    <h3>List of Teachers:</h3>

    <% if @department.teachers.any? %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Specialization</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @department.teachers.each do |teacher| %>
            <tr>
              <td><%= teacher.name %></td>
              <td><%= teacher.email %></td>
              <td><%= teacher.specialization %></td>
              <td>
                <%= button_to "Delete", teacher_path(teacher, from_department: @department.id), method: :delete, data: { confirm: "Are you sure?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>No teachers in this department.</p>
    <% end %>
  </div>

  <!-- Column 3: Laboratories -->
  <div>
    <h3>List of Laboratories:</h3>

    <% if @department.laboratories.any? %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @department.laboratories.each do |laboratory| %>
            <tr>
              <td><%= laboratory.name %></td>
              <td><%= laboratory.location %></td>
              <td>
                <%= button_to "Delete", laboratory_path(laboratory, from_department: @department.id), method: :delete, data: { confirm: "Are you sure?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>No laboratories in this department.</p>
    <% end %>
  </div>

</div>

<br><br>

<div>
  <%= button_to "Delete Department", department_path(@department), method: :delete, data: { confirm: "Are you sure?" } %>
  <%= link_to "Back to Departments", departments_path %>
</div>