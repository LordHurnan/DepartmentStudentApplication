<% content_for :title, @department.name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1"><%= @department.name %></h1>
    <p class="text-muted mb-0"><%= @department.location %></p>
  </div>
</div>

<!-- Department Information -->
<div class="card shadow-sm mb-4">
  <div class="card-header">
    <h3 class="mb-0">Department Information</h3>
  </div>

  <div class="card-body">
    <div class="row">

      <div class="col-md-6">
        <h6 class="text-muted">Name</h6>
        <p><%= @department.name %></p>

        <h6 class="text-muted">Location</h6>
        <p class="mb-0"><%= @department.location %></p>
      </div>

      <div class="col-md-6">
        <h6 class="text-muted mb-3">Summary</h6>

        <div class="row g-3">
          <div class="col-md-4">
            <div class="card bg-light h-100 text-center">
              <div class="card-body">
                <h6 class="card-title text-muted">Students</h6>
                <h3 class="mb-0"><%= @department.students_count %></h3>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="card bg-light h-100 text-center">
              <div class="card-body">
                <h6 class="card-title text-muted">Teachers</h6>
                <h3 class="mb-0"><%= @department.teachers_count %></h3>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="card bg-light h-100 text-center">
              <div class="card-body">
                <h6 class="card-title text-muted">Laboratories</h6>
                <h3 class="mb-0"><%= @department.laboratory %></h3>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- List of Students -->
<div class="card shadow-sm mb-4">
  <div class="card-header">
    <h3 class="mb-0">List of Students</h3>
  </div>

  <div class="card-body">
    <% if @department.students.any? %>
      <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Name</th>
              <th>Program</th>
              <th>Year Level</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% @department.students.each do |student| %>
              <tr id="<%= dom_id student %>">
                <td><%= student.name %></td>
                <td><%= student.program %></td>
                <td><%= student.year_level %></td>
                <td class="text-nowrap">
                  <%= button_to "Delete",
                      student,
                      method: :delete,
                      class: "btn btn-sm btn-danger",
                      form_class: "d-inline-block" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0">No students in this department.</p>
    <% end %>
  </div>
</div>

<!-- List of Teachers -->
<div class="card shadow-sm mb-4">
  <div class="card-header">
    <h3 class="mb-0">List of Teachers</h3>
  </div>

  <div class="card-body">
    <% if @department.teachers.any? %>
      <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Specialization</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% @department.teachers.each do |teacher| %>
              <tr id="<%= dom_id teacher %>">
                <td><%= teacher.name %></td>
                <td><%= teacher.email %></td>
                <td><%= teacher.specialization %></td>
                <td class="text-nowrap">
                  <%= button_to "Delete",
                      teacher,
                      method: :delete,
                      class: "btn btn-sm btn-danger",
                      form_class: "d-inline-block" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0">No teachers in this department.</p>
    <% end %>
  </div>
</div>

<!-- List of Laboratories -->
<div class="card shadow-sm mb-4">
  <div class="card-header">
    <h3 class="mb-0">List of Laboratories</h3>
  </div>

  <div class="card-body">
    <% if @department.laboratories.any? %>
      <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Name</th>
              <th>Location</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% @department.laboratories.each do |laboratory| %>
              <tr id="<%= dom_id laboratory %>">
                <td><%= laboratory.name %></td>
                <td><%= laboratory.location %></td>
                <td class="text-nowrap">
                  <%= button_to "Delete",
                      laboratory,
                      method: :delete,
                      class: "btn btn-sm btn-danger",
                      form_class: "d-inline-block" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0">No laboratories in this department.</p>
    <% end %>
  </div>
</div>

<!-- Department Actions -->
<div class="d-flex gap-2 mb-4">
  <%= button_to "Delete Department",
      @department,
      method: :delete,
      class: "btn btn-danger",
      form_class: "d-inline-block" %>

  <%= link_to "Back to Departments",
      departments_path,
      class: "btn btn-outline-secondary" %>
</div>