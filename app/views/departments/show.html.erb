<p style="color: green"><%= notice %></p>

<%= render @department %>

<div>
  <% if @department.students.any? %>
    <h3>List of Students:</h3>

    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Program</th>
          <th>Year Level</th>
        </tr>
      </thead>

      <tbody>
        <% @department.students.each do |student| %>
          <tr>
            <td><%= student.name %></td>
            <td><%= student.program %></td>
            <td><%= student.year_level %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No students in this department.</p>
  <% end %>
</div>

<div>
  <h3>List of Teachers:</h3>

  <% if @department.teachers.any? %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Specialization</th>
        </tr>
      </thead>

      <tbody>
        <% @department.teachers.each do |teacher| %>
          <tr>
            <td><%= teacher.name %></td>
            <td><%= teacher.email %></td>
            <td><%= teacher.specialization %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No teachers in this department.</p>
  <% end %>
</div>

<div>
  <h3>List of Laboratories:</h3>

  <% if @department.laboratories.any? %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Location</th>
        </tr>
      </thead>

      <tbody>
        <% @department.laboratories.each do |laboratory| %>
          <tr>
            <td><%= laboratory.name %></td>
            <td><%= laboratory.location %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No laboratories in this department.</p>
  <% end %>
</div>

<br>

<div>
  <%= link_to "Back to Departments", departments_path %>
</div>