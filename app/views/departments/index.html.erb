<p class="text-success"><%= notice %></p>

<% content_for :title, "Departments" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">Departments</h1>
    <p class="text-muted mb-0">Manage departments and their resources</p>
  </div>

  <%= link_to "New Department",
      new_department_path,
      class: "btn btn-success" %>
</div>

<div id="departments">
  <div class="row g-4">
    <% @departments.each do |department| %>
      <div class="col-md-6">
        <div class="card shadow-sm h-100">

          <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><%= department.name %></h4>
            <span class="badge bg-secondary">
              <%= department.location %>
            </span>
          </div>

          <div class="card-body">

            <p class="text-muted mb-3">
              <strong>Location:</strong>
              <%= department.location %>
            </p>

            <div class="row g-3 text-center">

              <div class="col-4">
                <div class="card bg-light h-100">
                  <div class="card-body">
                    <h6 class="text-muted">Students</h6>
                    <h3 class="mb-0">
                      <%= department.students.count %>
                    </h3>
                  </div>
                </div>
              </div>

              <div class="col-4">
                <div class="card bg-light h-100">
                  <div class="card-body">
                    <h6 class="text-muted">Teachers</h6>
                    <h3 class="mb-0">
                      <%= department.teachers.count %>
                    </h3>
                  </div>
                </div>
              </div>

              <div class="col-4">
                <div class="card bg-light h-100">
                  <div class="card-body">
                    <h6 class="text-muted">Laboratories</h6>
                    <h3 class="mb-0">
                      <%= department.laboratories.count %>
                    </h3>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <div class="card-footer bg-white">
            <%= link_to "View Department",
                department,
                class: "btn btn-primary w-100" %>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>