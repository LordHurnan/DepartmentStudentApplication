<% content_for :title, "Edit Subject" %>

<div class="d-flex justify-content-between align-items-center mb-4">

  <div>
    <h1 class="mb-1">Edit Subject</h1>

    <p class="text-muted mb-0">
      Update subject information
    </p>
  </div>

  <%= link_to "Back to Subjects",
      subjects_path,
      class: "btn btn-outline-secondary" %>

</div>


<!-- Subject Information -->
<div class="card shadow-sm mb-4">

  <div class="card-header">
    <h3 class="mb-0">Subject Information</h3>
  </div>

  <div class="card-body">

    <%= form_with model: @subject do |form| %>

      <% if @subject.errors.any? %>

        <div class="alert alert-danger">

          <h5>
            <%= pluralize(@subject.errors.count, "error") %>
            prohibited this subject from being saved:
          </h5>

          <ul class="mb-0">

            <% @subject.errors.each do |error| %>

              <li>
                <%= error.full_message %>
              </li>

            <% end %>

          </ul>

        </div>

      <% end %>


      <!-- Name -->
      <div class="mb-3">

        <%= form.label :name,
            "Name",
            class: "form-label" %>

        <%= form.text_field :name,
            class: "form-control",
            placeholder: "Enter subject name" %>

      </div>


      <!-- Teacher -->
      <div class="mb-3">

        <%= form.label :teacher_id,
            "Teacher",
            class: "form-label" %>

        <%= form.collection_select :teacher_id,
            Teacher.order(:name),
            :id,
            :name,
            { prompt: "Select Teacher" },
            { class: "form-select" } %>

      </div>


      <!-- Number of Units -->
      <div class="mb-3">

        <%= form.label :number_of_units,
            "Number of Units",
            class: "form-label" %>

        <%= form.number_field :number_of_units,
            class: "form-control",
            min: 0,
            placeholder: "Enter number of units" %>

      </div>


      <!-- Per Unit Rate -->
      <div class="mb-4">

        <%= form.label :per_unit_rate,
            "Per Unit Rate",
            class: "form-label" %>

        <%= form.number_field :per_unit_rate,
            class: "form-control",
            step: 0.01,
            min: 0,
            placeholder: "Enter per unit rate" %>

      </div>


      <!-- Buttons -->
      <div class="d-flex gap-2">

        <%= form.submit "Update Subject",
            class: "btn btn-primary" %>

        <%= link_to "Cancel",
            @subject,
            class: "btn btn-outline-secondary" %>

      </div>

    <% end %>

  </div>

</div>


<!-- Sections -->
<div class="card shadow-sm mb-4">

  <div class="card-header">
    <h3 class="mb-0">Sections</h3>
  </div>

  <div class="card-body">

    <% if @subject.sections.any? %>

      <div class="table-responsive">

        <table class="table table-striped table-hover table-bordered align-middle">

          <thead class="table-dark">

            <tr>
              <th>Section</th>
              <th>Room</th>
              <th>Timeslot</th>
              <th>Students</th>
            </tr>

          </thead>

          <tbody>

            <% @subject.sections.each do |section| %>

              <tr>

                <td>
                  <%= section.name %>
                </td>

                <td>
                  <%= section.room %>
                </td>

                <td>
                  <%= section.timeslot %>
                </td>

                <td>
                  <%= section.students.count %>
                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    <% else %>

      <p class="text-muted mb-0">
        No sections assigned to this subject.
      </p>

    <% end %>

  </div>

</div>


<!-- Navigation -->
<div class="d-flex gap-2">

  <%= link_to "Show this subject",
      @subject,
      class: "btn btn-secondary" %>

  <%= link_to "Back to Subjects",
      subjects_path,
      class: "btn btn-outline-secondary" %>

</div>