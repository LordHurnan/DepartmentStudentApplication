<% content_for :title, @subject.name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1"><%= @subject.name %></h1>
    <p class="text-muted mb-0">
      Subject | <%= @subject.teacher&.name || "No teacher assigned" %>
    </p>
  </div>

  <%= link_to "Back to Subjects",
      subjects_path,
      class: "btn btn-outline-secondary" %>
</div>


<!-- Subject Details -->
<div class="card shadow-sm mb-4">

  <div class="card-header">
    <h3 class="mb-0">Subject Details</h3>
  </div>

  <div class="card-body">

    <div class="row">

      <!-- Subject Information -->
      <div class="col-md-6">

        <h6 class="text-muted">Name</h6>
        <p><%= @subject.name %></p>

        <h6 class="text-muted">Teacher</h6>
        <p>
          <%= @subject.teacher&.name || "No teacher assigned" %>
        </p>

      </div>


      <!-- Subject Summary -->
      <div class="col-md-6">

        <h6 class="text-muted mb-3">Subject Summary</h6>

        <div class="row g-3">

          <!-- Number of Units -->
          <div class="col-md-6">

            <div class="card bg-light h-100 text-center">

              <div class="card-body">

                <h6 class="card-title text-muted">
                  Number of Units
                </h6>

                <h3 class="mb-0">
                  <%= @subject.number_of_units %>
                </h3>

              </div>

            </div>

          </div>


          <!-- Per Unit Rate -->
          <div class="col-md-6">

            <div class="card bg-light h-100 text-center">

              <div class="card-body">

                <h6 class="card-title text-muted">
                  Per Unit Rate
                </h6>

                <h4 class="mb-0">
                  <%= number_to_currency @subject.per_unit_rate, unit: "₱" %>
                </h4>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>


<!-- Sections -->
<div class="card shadow-sm mb-4">

  <div class="card-header">
    <h3 class="mb-0">Sections</h3>
  </div>

  <div class="card-body">

    <% if @subject.sections.any? %>

      <% @subject.sections.each do |section| %>

        <div class="card bg-light mb-4">

          <div class="card-body">

            <h4 class="mb-2">
              <%= section.name %>
            </h4>

            <p class="text-muted mb-3">
              Room: <%= section.room %>
              |
              Timeslot: <%= section.timeslot %>
              |
              Teacher:
              <%= @subject.teacher&.name || "No teacher assigned" %>
            </p>


            <% if section.students.any? %>

              <div class="table-responsive">

                <table class="table table-striped table-hover table-bordered align-middle mb-0">

                  <thead class="table-dark">

                    <tr>
                      <th>Name</th>
                      <th>Year Level</th>
                      <th>Program</th>
                    </tr>

                  </thead>

                  <tbody>

                    <% section.students.each do |student| %>

                      <tr>

                        <td>
                          <%= student.name %>
                        </td>

                        <td>
                          <%= student.year_level %>
                        </td>

                        <td>
                          <%= student.program %>
                        </td>

                      </tr>

                    <% end %>

                  </tbody>

                </table>

              </div>

            <% else %>

              <p class="text-muted mb-0">
                No students enrolled in this section.
              </p>

            <% end %>

          </div>

        </div>

      <% end %>

    <% else %>

      <p class="text-muted mb-0">
        No sections assigned to this subject.
      </p>

    <% end %>

  </div>

</div>


<!-- Subject Actions -->
<div class="card shadow-sm">

  <div class="card-header">
    <h3 class="mb-0">Subject Actions</h3>
  </div>

  <div class="card-body">

    <%= link_to "Edit Subject",
        edit_subject_path(@subject),
        class: "btn btn-primary" %>

    <%= link_to "Back to Subjects",
        subjects_path,
        class: "btn btn-secondary" %>

    <%= button_to "Delete Subject",
        @subject,
        method: :delete,
        class: "btn btn-danger",
        form_class: "d-inline-block",
        data: {
          turbo_confirm: "Are you sure you want to delete this subject?"
        } %>

  </div>

</div>