<p class="text-success"><%= notice %></p>

<% content_for :title, "Subjects" %>

<h1>Subjects</h1>

<%= search_form_for @q, url: subjects_path, class: "card card-body mb-4" do |f| %>
  <div class="row g-3 align-items-end">
    <div class="col-md-5">
      <%= f.label :name_cont, "Search", class: "form-label" %>
      <%= f.search_field :name_cont, class: "form-control", placeholder: "Subject name..." %>
    </div>
    <div class="col-md-4">
      <%= f.label :teacher_id_eq, "Teacher", class: "form-label" %>
      <%= f.collection_select :teacher_id_eq, Teacher.order(:name), :id, :name,
            { include_blank: "All teachers" }, { class: "form-select" } %>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <%= f.submit "Search", class: "btn btn-primary" %>
      <%= link_to "Reset", subjects_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
<% end %>

<div id="subjects" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">

    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Teacher</th>
        <th>Number of Units</th>
        <th>Per Unit Rate</th>
        <th>Sections</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @subjects.each do |subject| %>
        <tr id="<%= dom_id subject %>">

          <td><%= subject.name %></td>

          <td>
            <%= subject.teacher&.name || "No teacher assigned" %>
          </td>

          <td>
            <%= subject.number_of_units %>
          </td>

          <td>
            <%= number_to_currency subject.per_unit_rate, unit: "₱" %>
          </td>

          <td>
            <%= subject.sections.count %>
          </td>

          <td class="text-nowrap">

            <%= button_to "Show",
                subject,
                method: :get,
                class: "btn btn-sm btn-primary",
                form_class: "d-inline-block" %>

            <%= button_to "Edit",
                edit_subject_path(subject),
                method: :get,
                class: "btn btn-sm btn-secondary",
                form_class: "d-inline-block" %>

            <%= button_to "Delete",
                subject,
                method: :delete,
                class: "btn btn-sm btn-danger",
                form_class: "d-inline-block" %>

          </td>

        </tr>
      <% end %>
    </tbody>

  </table>
</div>

<div class="d-flex justify-content-center mt-3">
  <%== @pagy.series_nav(:bootstrap) %>
</div>

<%= link_to "New subject",
    new_subject_path,
    class: "btn btn-success" %>